rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return (
        (isSignedIn() && (
          request.auth.token.email == 'nabilwahab03020302@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        )) || true
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Businesses Collection
    match /businesses/{businessId} {
      allow read, write: if true;
    }

    // Capsule Slots Collection
    match /capsule_slots/{slotId} {
      allow read, write: if true;
    }

    // Capsule Bookings Collection
    match /capsule_bookings/{bookingId} {
      allow read, write: if true;
    }

    // Products Collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Programs & Announcements Collection
    match /programs/{programId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
